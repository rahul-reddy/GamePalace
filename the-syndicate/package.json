{
  "name": "the-syndicate",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "test": "vitest run",
    "test:engine": "vitest run --project game-engine",
    "test:coverage": "pnpm --filter @syndicate/game-engine exec vitest run --coverage && vitest run",
    "build": "pnpm -r run build",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "test:recovery": "vitest run --config tests/recovery/vitest.config.ts",
    "test:security": "vitest run --config tests/integration/vitest.config.ts tests/security",
    "test:e2e": "playwright test",
    "test:e2e:4p": "playwright test --grep @4p",
    "test:e2e:8p": "playwright test --grep @8p",
    "test:e2e:12p": "playwright test --grep @12p",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "test:balance": "tsx packages/test-bots/src/cli.ts --matches 10000 --report reports/balance",
    "sim:check": "tsx packages/test-bots/src/cli.ts --matches 600 --check",
    "test:load": "tsx scripts/load-test.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@syndicate/game-engine": "workspace:*",
    "@syndicate/shared": "workspace:*",
    "@syndicate/test-bots": "workspace:*",
    "@types/node": "25.9.9",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
