{
  // THE SYNDICATE: one Worker serves the web app and routes /api/* to room Durable Objects.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "the-syndicate",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "DIRECTORY", "class_name": "RoomDirectory" },
      { "name": "LIMITER", "class_name": "RateLimiter" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "RoomDirectory", "RateLimiter"] }],
  "vars": {
    // Comma-separated extra origins allowed to call the API (same-origin is always allowed).
    "ALLOWED_ORIGINS": "",
    // "1" exposes test-only endpoints (phase fast-forward, replay log). Never set in production.
    "TEST_MODE": "0",
    // Overridden by scripts/deploy.ps1 with the deployed commit SHA.
    "REVISION": "dev",
  },
  "env": {
    // Bindings and vars are not inherited by environments, so staging repeats them.
    "staging": {
      "name": "the-syndicate-staging",
      "durable_objects": {
        "bindings": [
          { "name": "ROOMS", "class_name": "Room" },
          { "name": "DIRECTORY", "class_name": "RoomDirectory" },
          { "name": "LIMITER", "class_name": "RateLimiter" },
        ],
      },
      "vars": { "ALLOWED_ORIGINS": "", "TEST_MODE": "0", "REVISION": "dev" },
    },
  },
}
