{
  // THE SYNDICATE: one Worker serves the web app and routes /api/* to room Durable Objects.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "the-syndicate",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    // Comma-separated extra origins allowed to call the API (same-origin is always allowed).
    "ALLOWED_ORIGINS": "",
    // "1" exposes test-only endpoints (deterministic seeds). Never set in production.
    "TEST_MODE": "0",
  },
  "env": {
    "staging": {
      "name": "the-syndicate-staging",
      "vars": { "ALLOWED_ORIGINS": "", "TEST_MODE": "0" },
    },
  },
}
